body {
  background-image: url("bg.jpg"); /* https://tse3.mm.bing.net/th/id/OIP.rzvy0fpTXAzmaVPIJdAErAHaE8?cb=ucfimg2&pid=ImgDet&ucfimg=1&w=202&h=134&c=7&dpr=2&o=7&rm=3 */
  background-size: cover;
  background-repeat: no-repeat;
  background-attachment: fixed;
  background-position: center;
  /* 淡色效果核心：叠加半透明遮罩，不影响文字可读性 */
  position: relative;
}
body::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(255, 255, 255, 0.7); /* 0.7 是透明度，可改 0.5-0.9 */
  z-index: -1;
}
/* 可选：增强页面容器可读性 */
.page-container {
  background-color: rgba(255, 255, 255, 0.9);
  margin: 20px auto;
  padding: 30px;
  max-width: 1200px;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
